TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
NODE_ENV=development
DATABASE_URL=postgres://myuser:mysecretpassword@localhost:5432/mydatabase

# user jwt
USER_JWT_SECRET=replace-with-a-long-random-string
USER_JWT_EXPIRES_IN=1h
USER_JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
USER_JWT_REFRESH_EXPIRES_IN=7d
USER_JWT_REFRESH_COOKIE_MAX_AGE=604800000

# device jwt
DEVICE_JWT_SECRET=replace-with-a-long-random-string
DEVICE_JWT_EXPIRES_IN=30d
DEVICE_JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
DEVICE_JWT_REFRESH_EXPIRES_IN=365d
DEVICE_JWT_REFRESH_COOKIE_MAX_AGE=31536000000
